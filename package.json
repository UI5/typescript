{
  "name": "root",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "build": "pnpm --filter @ui5/dts-generator run build && pnpm --filter @ui5/ts-interface-generator run build",
    "preci": "pnpm run build",
    "ci": "pnpm run format:validate && pnpm run ci:subpackages",
    "ci:subpackages": "pnpm -r run ci",
    "changeset": "changeset",
    "changeset:auto": "node scripts/auto-changeset.mjs",
    "changeset:empty": "changeset --empty",
    "version-packages": "changeset version && pnpm install --no-frozen-lockfile --ignore-scripts",
    "release-publish": "changeset publish",
    "format:fix": "prettier --write \"**/*.@(ts|js|json|md|yml)\"",
    "format:validate": "prettier --check \"**/*.@(ts|js|json|md|yml)\"",
    "prepare": "husky",
    "hooks:pre-commit": "lint-staged",
    "hooks:commit-msg": "commitlint -e",
    "ncu": "ncu -ws --root",
    "ncu-u": "ncu -ws --root -u"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "chai": "6.2.2",
    "cz-conventional-changelog": "3.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "mocha": "12.0.2",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.6",
    "shx": "0.4.0",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{ts,js,json,md,yml}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
