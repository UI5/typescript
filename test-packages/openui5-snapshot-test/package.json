{
  "name": "@ui5/openui5-snapshot-test",
  "private": true,
  "version": "4.0.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git@github.com:UI5/typescript.git",
    "directory": "test-packages/openui5-snapshot-test"
  },
  "dependencies": {
    "@ui5/dts-generator": "link:../../packages/dts-generator",
    "fs-extra": "11.4.0",
    "lodash": "4.18.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/jquery": "3.5.32",
    "@types/qunit": "2.5.4"
  },
  "scripts": {
    "ci": "npm-run-all test dts:run-check",
    "test": "mocha \"./test/**/*spec.js\"",
    "dts:run-check": "node ../../packages/dts-generator/dist/runCheck.js output-dts",
    "re-generate": "npm-run-all sdk:* dts:*",
    "sdk:download": "node ./lib/download-sdk.js",
    "sdk:format": "prettier --write \"input-sdk/*.json\"",
    "dts:generate": "node ./lib/generate-dts.js",
    "dts:verify": "tsc -p ."
  },
  "mocha": {
    "diff": false
  },
  "snapshot": {
    "version": "1.120.30",
    "libs": [
      "sap.ui.core",
      "sap.m",
      "sap.f",
      "sap.tnt"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
