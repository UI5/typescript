# Supply-chain hardening (migrated from .yarnrc, extended)

# Pin exact versions on `npm install` / `npm add` (no ^ or ~ prefix).
save-exact=true

# Explicit registry — prevents dependency confusion.
registry=https://registry.npmjs.org/

# Block git dependencies.
allow-git=none

# Require packages to have been published for 3 days before install.
# Aligned with the fastest Renovate path (vulnerability alerts use
# minimumReleaseAge: 3 days); a higher value here would block CI on
# security-fix PRs that Renovate already approved.
min-release-age=3
